---
import BaseLayout from './BaseLayout.astro';
import { legalNav } from '../data/site';

interface Props {
  title: string;
  eyebrow: string;
  heading: string;
  /** One-sentence framing under the h1. */
  lede: string;
  description: string;
  lastUpdated: string;
}

const { title, eyebrow, heading, lede, description, lastUpdated } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === (href.replace(/\/+$/, '') || '/');
---

<BaseLayout title={title} description={description}>
  <section
    class="border-b border-line pt-[clamp(3.25rem,6vw,5rem)] pb-[clamp(3.5rem,6vw,5.5rem)]"
  >
    <div class="container-x">
      <div
        class="grid gap-[clamp(2rem,4vw,4rem)] lg:grid-cols-[minmax(13.75rem,1fr)_2.4fr]"
      >
        <nav aria-label="Trust" class="self-start">
          <p class="eyebrow text-[0.65625rem] tracking-[0.18em]">Trust</p>
          <div class="mt-3.5 grid border-t border-line">
            {
              legalNav.map((item) => (
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class="border-b border-line py-[13px] text-[0.96875rem] font-semibold text-ink transition-colors hover:text-sec aria-[current=page]:text-sec"
                >
                  {item.label}
                </a>
              ))
            }
          </div>
          <p class="mt-[1.375rem] text-[0.8125rem] leading-[1.6] text-slate-400">
            Machine-readable disclosure policy is published at{' '}
            <a
              href="/.well-known/security.txt"
              class="underline decoration-line-strong underline-offset-4 hover:decoration-ink"
            >
              /.well-known/security.txt
            </a>
          </p>
        </nav>

        <div class="min-w-0 max-w-[44rem]">
          <p class="eyebrow eyebrow-accent">{eyebrow}</p>
          <h1 class="h-section mt-5 text-ink">{heading}</h1>
          <p class="mt-5 text-[1.0625rem] leading-[1.7] text-slate">{lede}</p>
          <p class="mt-4 text-[0.8125rem] text-slate-400">Last updated: {lastUpdated}</p>

          <slot />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
