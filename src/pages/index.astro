---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Credentials from '../components/Credentials.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Products from '../components/Products.astro';
import Structure from '../components/Structure.astro';
import Principles from '../components/Principles.astro';
import Journey from '../components/Journey.astro';
import ContactCta from '../components/ContactCta.astro';
import { company } from '../data/site';
---

<BaseLayout
  title="Litesoc Sdn Bhd | Software, Cybersecurity & Technology Solutions"
  description={company.description}
  structuredData
>
  <Hero />
  <Credentials />
  <About />
  <Services />
  <Products />
  <Structure />
  <Principles />
  <Journey />
  <ContactCta />
</BaseLayout>
