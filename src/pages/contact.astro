---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { company, contactChannels, products } from '../data/site';

const credentials = [
  { label: 'Legal name', value: company.legalName },
  { label: 'Co. Reg. No.', value: company.registrationNo },
  { label: 'D-U-N-S', value: company.duns },
  { label: 'Products', value: products.map((product) => product.name).join(' · ') },
] as const;
---

<BaseLayout
  title="Contact | Litesoc Sdn Bhd"
  description={`How to reach ${company.legalName} — general enquiries, security reports, careers, and our registered office in Shah Alam, Selangor.`}
>
  <PageHero
    eyebrow="Contact"
    heading="Let&rsquo;s Build Something That Matters."
    lede="Whether you are developing a digital platform, improving cybersecurity or modernising infrastructure, talk to us about what you are trying to achieve."
    headingWidth="34rem"
  />

  <section class="border-b border-line py-[clamp(3rem,5vw,5rem)]">
    <div class="container-x">
      <div
        class="hairline grid-cols-[repeat(auto-fit,minmax(min(16.25rem,100%),1fr))] border border-line"
      >
        {
          contactChannels.map((channel) => (
            <div class="bg-paper px-[1.625rem] py-7">
              <p class="eyebrow text-[0.65625rem] tracking-[0.18em]">{channel.label}</p>
              <a
                href={`mailto:${channel.email}`}
                class="mt-3.5 inline-block text-lg font-bold text-ink transition-colors hover:text-sec"
              >
                {channel.email}
              </a>
              <p class="mt-2.5 text-[0.90625rem] leading-[1.6] text-slate">{channel.body}</p>
            </div>
          ))
        }
      </div>

      <div
        class="mt-[clamp(2.5rem,4vw,4rem)] grid grid-cols-[repeat(auto-fit,minmax(min(20rem,100%),1fr))] gap-[clamp(2.25rem,5vw,4rem)]"
      >
        <div>
          <p class="eyebrow">Registered office</p>
          <address class="mt-[1.125rem] text-[1.0625rem] not-italic leading-[1.7] text-ink">
            Unit 17.2, Level 17, Wisma Sunway<br />
            No. 1 Jalan Tengku Ampuan Zabedah C9/C<br />
            Seksyen 9<br />
            40100 Shah Alam<br />
            Selangor, Malaysia
          </address>
        </div>

        <div>
          <p class="eyebrow">Corporate credentials</p>
          <div class="mt-[1.125rem] grid border-t-2 border-ink">
            {
              credentials.map((item) => (
                <div class="grid grid-cols-[repeat(auto-fit,minmax(min(10.625rem,100%),1fr))] gap-4 border-b border-line py-4">
                  <span class="text-[0.8125rem] text-slate-400">{item.label}</span>
                  <span class="text-[0.9375rem] font-semibold tracking-[0.01em] text-ink">
                    {item.value}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
