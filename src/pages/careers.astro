---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { company, openPositions, waysOfWorking } from '../data/site';
---

<BaseLayout
  title="Careers | Litesoc Sdn Bhd"
  description={`Engineering roles at ${company.legalName} — a small team building its own platforms and delivering technology work for organizations that depend on it.`}
>
  <PageHero
    eyebrow="Careers"
    heading="Engineering work with real consequences."
    lede="We are a small engineering team building our own platforms and delivering technology work for organizations that depend on it."
    headingWidth="34rem"
  />

  <section class="border-b border-line py-[clamp(3.5rem,6vw,5.5rem)]">
    <div class="container-x">
      <div
        class="grid grid-cols-[repeat(auto-fit,minmax(min(20rem,100%),1fr))] gap-[clamp(2.25rem,5vw,4rem)]"
      >
        <div>
          <p class="eyebrow">Open positions</p>

          {
            openPositions.length === 0 ? (
              <div class="mt-[1.375rem] border border-line-strong bg-mist p-[clamp(1.625rem,3vw,2.375rem)]">
                <p class="text-[clamp(1.3125rem,1.1rem+0.9vw,1.6875rem)] font-bold leading-[1.25] tracking-[-0.02em] text-ink">
                  There are currently no open positions.
                </p>
                <p class="mt-3.5 text-[0.96875rem] leading-[1.65] text-slate">
                  We still read every message. If your work is close to what we do, send a short
                  note and a link to something you have built.
                </p>
                <a href={`mailto:${company.careersEmail}`} class="btn btn-primary mt-[1.625rem]">
                  {company.careersEmail}
                </a>
              </div>
            ) : (
              <ul class="mt-[1.375rem] grid list-none border-t-2 border-ink p-0">
                {openPositions.map((role) => (
                  <li class="border-b border-line">
                    <a href={role.href} class="flex flex-wrap items-baseline justify-between gap-3 py-5">
                      <span class="text-[1.0625rem] font-bold text-ink">{role.title}</span>
                      <span class="text-[0.875rem] text-slate-400">{role.location}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div>
          <p class="eyebrow">How we work</p>
          <div class="mt-[1.375rem] grid border-t-2 border-ink">
            {
              waysOfWorking.map((item) => (
                <div class="border-b border-line py-5">
                  <h2 class="text-[1.0625rem] font-bold text-ink">{item.title}</h2>
                  <p class="mt-[7px] text-[0.9375rem] leading-[1.6] text-slate">{item.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
