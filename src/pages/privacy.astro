---
import LegalLayout from '../layouts/LegalLayout.astro';
import LegalStack from '../components/LegalStack.astro';
import LegalItem from '../components/LegalItem.astro';
import { company, products } from '../data/site';

/*
  Scope note: this page describes only litesoc.app, the corporate website.
  It deliberately makes no claims about the products, which publish their own
  notices. Every statement here is verifiable against how this site is built.
*/
const lastUpdated = new Date().toISOString().slice(0, 10);
---

<LegalLayout
  title="Privacy | Litesoc Sdn Bhd"
  eyebrow="Privacy"
  heading="Privacy Notice"
  lede="This notice covers this website only. It is not the privacy policy for LiteSOC or Digital Khairat — each product publishes its own."
  description="How litesoc.app, the corporate website of Litesoc Sdn Bhd, handles visitor information."
  lastUpdated={lastUpdated}
>
  <LegalStack>
    <LegalItem heading="Scope">
      <p>
        This notice covers <strong>litesoc.app</strong>, the corporate website of {
          company.legalName
        }. It does not cover the products listed below, which operate separately and publish their
        own terms and privacy information on their own sites.
      </p>
      <ul>
        {
          products.map((product) => (
            <li>
              {product.name} &mdash;{' '}
              <a href={product.url} target="_blank" rel="noopener noreferrer">
                {product.domain}
              </a>
            </li>
          ))
        }
      </ul>
    </LegalItem>

    <LegalItem heading="What this site collects">
      <p>
        This website is a static site. It contains no contact forms, no accounts, no analytics
        scripts, no advertising scripts and no third-party trackers. It does not set cookies, and it
        does not ask you for personal information.
      </p>
    </LegalItem>

    <LegalItem heading="Hosting">
      <p>
        The site is served as static files by GitHub Pages. Like any web host, the hosting provider
        processes standard technical request data such as IP addresses in order to deliver pages and
        protect the service. That processing is governed by GitHub&rsquo;s own privacy practices, not
        by this site.
      </p>
    </LegalItem>

    <LegalItem heading="Email">
      <p>
        If you email <a href={`mailto:${company.email}`}>{company.email}</a>, we receive the contents
        of your message and your email address, and use them only to respond to your enquiry. We keep
        your message and contact details for as long as needed to respond and to maintain a record of
        the enquiry.
      </p>
    </LegalItem>

    <LegalItem heading="Changes">
      <p>
        If this website changes in a way that affects the statements above, this page will be updated
        at the same time.
      </p>
    </LegalItem>

    <LegalItem heading="Questions">
      <p>
        Contact <a href={`mailto:${company.email}`}>{company.email}</a>.
      </p>
    </LegalItem>
  </LegalStack>
</LegalLayout>
