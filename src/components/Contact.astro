---
import { company, products, accentClasses } from '../data/site';
---

<section id="contact" class="scroll-mt-24 bg-ink py-20 text-paper sm:py-24 lg:py-28">
  <div class="container-x">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <p class="eyebrow text-paper/50">Contact</p>
        <h2 class="rule-heading mt-5 text-paper">Let&rsquo;s Connect</h2>
        <p class="mt-5 max-w-[34rem] text-[1.0625rem] leading-relaxed text-paper/70">
          For corporate, partnership, or general enquiries about {company.legalName}, email us
          directly. For questions about a specific platform, the product teams are reachable through
          their own sites.
        </p>

        <div class="mt-9">
          <a
            href={`mailto:${company.email}`}
            class="inline-flex min-h-12 items-center gap-3 rounded-sm bg-paper px-6 py-3.5 text-[0.9375rem] font-medium text-ink transition-colors hover:bg-line"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              aria-hidden="true"
            >
              <rect x="1.5" y="3" width="13" height="10" rx="1" />
              <path d="M1.5 4.5L8 9l6.5-4.5" />
            </svg>
            {company.email}
          </a>
        </div>

        <div class="mt-10 border-t border-paper/12 pt-8">
          <p class="eyebrow text-paper/50">Registered office</p>
          <address class="mt-4 text-[0.9375rem] leading-relaxed text-paper/70 not-italic">
            {company.address.lines.map((line) => <span class="block">{line}</span>)}
          </address>
          <dl class="mt-6 space-y-2">
            <div class="flex flex-wrap gap-x-3 gap-y-1">
              <dt class="font-mono text-[0.6875rem] tracking-[0.14em] text-paper/45 uppercase">
                Co. Reg. No.
              </dt>
              <dd class="font-mono text-xs text-paper/75">{company.registrationNo}</dd>
            </div>
            <div class="flex flex-wrap gap-x-3 gap-y-1">
              <dt class="font-mono text-[0.6875rem] tracking-[0.14em] text-paper/45 uppercase">
                D-U-N-S
              </dt>
              <dd class="font-mono text-xs text-paper/75">{company.duns}</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="lg:col-span-6 lg:pt-2">
        <p class="eyebrow text-paper/50">Product enquiries</p>

        <ul class="mt-6 divide-y divide-paper/12 border-y border-paper/12">
          {
            products.map((product) => {
              const accent = accentClasses[product.accent];
              return (
                <li>
                  <a
                    href={product.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center justify-between gap-5 py-6"
                  >
                    <span class="flex items-start gap-4">
                      <span aria-hidden="true" class={`mt-1.5 h-9 w-[3px] shrink-0 ${accent.rule}`} />
                      <span class="flex flex-col">
                        <span class="text-lg font-semibold tracking-[-0.015em] text-paper">
                          {product.name}
                        </span>
                        <span class="mt-1 font-mono text-xs text-paper/50">{product.domain}</span>
                      </span>
                    </span>
                    <span class="sr-only">
                      Visit the {product.name} website (opens in a new tab)
                    </span>
                    <svg
                      class="h-4 w-4 shrink-0 text-paper/60 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-paper"
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      aria-hidden="true"
                    >
                      <path d="M2.5 8h10M8.5 3.5L13 8l-4.5 4.5" />
                    </svg>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </div>
</section>
