---
import Wordmark from './Wordmark.astro';
import { company, legalNav, products, services } from '../data/site';

const year = new Date().getFullYear();
/* The footer lists the practice areas but points every one at the services
   page — there are no per-service routes, and inventing anchors that scroll
   to nothing is worse than a single honest destination. */
const servicesLinks = services.slice(0, 4);
---

<footer class="border-t-2 border-ink bg-paper">
  <div class="container-x">
    <div class="flex flex-wrap gap-[clamp(2rem,4vw,3.5rem)] py-[clamp(3rem,5vw,4.5rem)]">
      <div class="min-w-0 max-w-[26rem] flex-[0_1_17.5rem]">
        <Wordmark size={40} href={null} />
        <p class="mt-[1.375rem] max-w-[22rem] text-[0.9375rem] leading-relaxed text-slate">
          A Malaysian technology company &mdash; the company behind {products[0].name} and {
            products[1].name
          }.
        </p>
        <a
          href={`mailto:${company.email}`}
          class="mt-3.5 inline-block border-b border-line-strong pb-0.5 text-[0.9375rem] font-semibold text-ink transition-colors hover:border-ink"
        >
          {company.email}
        </a>
        <address class="mt-6 text-[0.8125rem] leading-[1.7] text-slate-400 not-italic">
          {company.address.lines.map((line, i) => <>{i > 0 && <br />}{line}</>)}
        </address>
      </div>

      <div
        class="grid min-w-0 flex-[1_1_26.25rem] grid-cols-[repeat(auto-fit,minmax(min(7.5rem,100%),1fr))] gap-[clamp(1rem,2vw,2.25rem)]"
      >
        <nav aria-label="Company" class="min-w-0">
          <p class="eyebrow text-[0.65625rem] tracking-[0.18em]">Company</p>
          <div class="mt-3.5 grid gap-0.5">
            <a href="/company/" class="py-[5px] text-[0.9375rem] text-slate hover:text-ink">
              Company
            </a>
            <a href="/careers/" class="py-[5px] text-[0.9375rem] text-slate hover:text-ink">
              Careers
            </a>
            <a href="/contact/" class="py-[5px] text-[0.9375rem] text-slate hover:text-ink">
              Contact
            </a>
          </div>
        </nav>

        <nav aria-label="Services" class="min-w-0">
          <p class="eyebrow text-[0.65625rem] tracking-[0.18em]">Services</p>
          <div class="mt-3.5 grid gap-0.5">
            {
              servicesLinks.map((service) => (
                <a href="/services/" class="py-[5px] text-[0.9375rem] text-slate hover:text-ink">
                  {service.name}
                </a>
              ))
            }
          </div>
        </nav>

        <nav aria-label="Products and trust" class="min-w-0">
          <p class="eyebrow text-[0.65625rem] tracking-[0.18em]">Products</p>
          <div class="mt-3.5 grid gap-0.5">
            {
              products.map((product) => (
                <a
                  href={product.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="py-[5px] text-[0.9375rem] text-slate hover:text-ink"
                >
                  {product.name}
                </a>
              ))
            }
          </div>

          <p class="eyebrow mt-[1.625rem] text-[0.65625rem] tracking-[0.18em]">Trust</p>
          <div class="mt-3.5 grid gap-0.5">
            {
              legalNav.map((item) => (
                <a href={item.href} class="py-[5px] text-[0.9375rem] text-slate hover:text-ink">
                  {item.label}
                </a>
              ))
            }
          </div>
        </nav>
      </div>
    </div>

    <div
      class="flex flex-wrap items-center justify-between gap-4 border-t border-line py-6"
    >
      <div>
        <p class="text-[0.8125rem] text-slate-400">
          &copy; {year} {company.legalName}. All rights reserved.
        </p>
        <p class="mt-[5px] text-xs tracking-[0.02em] text-slate-400">
          Co. Reg. No. {company.registrationNo} &middot; D-U-N-S {company.duns}
        </p>
      </div>
      <p class="text-xs tracking-[0.02em] text-slate-400">litesoc.app</p>
    </div>
  </div>
</footer>
