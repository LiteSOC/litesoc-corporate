---
import { accentClasses, company, products, services } from '../data/site';
---

<div>
  <div class="border-t-2 border-ink bg-paper px-5 py-[1.125rem]">
    <p class="text-[1.0625rem] font-bold tracking-[-0.015em] text-ink">{company.legalName}</p>
    <p class="eyebrow mt-1.5 tracking-[0.16em]">Company</p>
  </div>

  <div class="ml-[1.375rem] h-[1.625rem] border-l border-line-strong"></div>

  <div class="grid gap-3.5">
    <div class="border border-line bg-paper px-[1.125rem] py-4">
      <p class="text-[0.90625rem] font-bold text-ink">Products</p>
      <div class="mt-3 grid gap-[9px] border-t border-line pt-3">
        {
          products.map((product) => (
            <div class="flex items-center gap-2.5">
              <span class:list={['h-0.5 w-3 shrink-0', accentClasses[product.accent].rule]} />
              <span class="text-[0.84375rem] font-semibold text-ink">{product.name}</span>
              <span class="text-[0.71875rem] tracking-[0.02em] text-slate-400">
                {product.domain}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="border border-line bg-paper px-[1.125rem] py-4">
      <p class="text-[0.90625rem] font-bold text-ink">Services</p>
      <div class="mt-3 grid gap-[9px] border-t border-line pt-3">
        {
          services.map((service) => (
            <div class="flex items-center gap-2.5">
              <span class="h-0.5 w-3 shrink-0 bg-line-strong" />
              <span class="text-[0.84375rem] text-slate">{service.name}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
