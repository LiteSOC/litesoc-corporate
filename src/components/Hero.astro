---
import { statSync } from 'node:fs';
import StructureTree from './StructureTree.astro';
import { company } from '../data/site';

const { path: profilePath, filename: profileFilename } = company.corporateProfile;

// Read the size at build time so the label can never drift from the actual file.
const profileBytes = statSync(`public${profilePath}`).size;
const profileSize =
  profileBytes < 1_000_000
    ? `${Math.round(profileBytes / 1_000)} KB`
    : `${(profileBytes / 1_000_000).toFixed(1)} MB`;
const profileMeta = `PDF, ${profileSize}`;

/* Non-breaking hyphen: "Real-World" must never wrap across the hyphen in the
   display size, where the orphaned half reads as a typo. */
const tagline = company.tagline.replace('Real-World', 'Real‑World');
---

<section class="ruled border-b border-line bg-top">
  <div class="container-x">
    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(min(25rem,100%),1fr))] items-start gap-[clamp(2.5rem,5vw,4.5rem)] pt-[clamp(3.5rem,7vw,6.5rem)] pb-[clamp(3.25rem,6vw,5.5rem)]"
    >
      <div>
        <p class="eyebrow eyebrow-accent">Malaysian Technology Company</p>

        <h1 class="h-display mt-[1.375rem] text-ink">{tagline}</h1>

        <p class="mt-[1.625rem] max-w-[34rem] text-lg leading-[1.6] text-slate">
          {company.positioning}
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/services/" class="btn btn-primary">Explore What We Do</a>
          <a href="/products/" class="btn btn-secondary">Our Products</a>
          <a
            href={profilePath}
            download={profileFilename}
            type="application/pdf"
            class="btn btn-secondary"
            aria-label={`Download the ${company.legalName} corporate profile (${profileMeta})`}
          >
            <svg
              aria-hidden="true"
              class="h-4 w-4 shrink-0"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"
            >
              <path d="M8 1.75v8.5m0 0L4.75 7M8 10.25 11.25 7"></path>
              <path d="M2.25 11.75v2.5h11.5v-2.5"></path>
            </svg>
            Corporate Profile
          </a>
        </div>
        <p class="mt-3 text-[0.8125rem] text-slate-400">{profileMeta}</p>

        <div class="mt-[1.625rem] border-t border-line pt-[1.625rem]">
          <span class="eyebrow tracking-[0.18em]">
            {company.hq} &middot; {company.country}
          </span>
        </div>
      </div>

      <div class="border border-line-strong bg-mist p-[clamp(1.375rem,2.4vw,2rem)]">
        <p class="eyebrow mb-[1.375rem] tracking-[0.18em]">Corporate structure</p>
        <StructureTree />
      </div>
    </div>
  </div>
</section>
