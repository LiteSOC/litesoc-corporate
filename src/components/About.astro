---
import { capabilities } from '../data/site';

const concepts = [
  {
    title: 'Secure-by-design technology',
    body: 'Security requirements are part of how a product is scoped, not a layer added at the end.',
  },
  {
    title: 'Practical digital transformation',
    body: 'We replace manual, fragmented processes with software that fits the way an organization already works.',
  },
  {
    title: 'Built to be operated',
    body: 'We plan for the running of a system, not just its delivery — our own platforms are maintained with a roadmap, and client work is handed over documented.',
  },
];
---

<section id="about" class="scroll-mt-24 border-b border-line py-20 sm:py-24 lg:py-28">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5 lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">The company</p>
        <h2 class="rule-heading mt-5 text-ink">About Litesoc</h2>
      </div>

      <div class="lg:col-span-7">
        <div class="max-w-[42rem] space-y-6 text-[1.0625rem] leading-relaxed text-slate">
          <p>
            Litesoc Sdn Bhd is a Malaysian technology company focused on building digital products
            and delivering practical technology solutions. Our work spans software engineering,
            cybersecurity, cloud, networking and infrastructure, alongside the development of our
            own platforms.
          </p>
          <p>
            We work on problems that are ordinary but consequential &mdash; keeping systems
            monitored, keeping records accurate, keeping networks segmented, keeping members
            informed. Whether we are delivering a client engagement or developing one of our own
            products, the standards are the same: secure defaults, clear interfaces, and systems
            designed around real operational workflows rather than assumptions about them.
          </p>
        </div>

        <ul class="mt-12 grid gap-px border-y border-line bg-line sm:mt-14">
          {
            concepts.map((concept) => (
              <li class="bg-paper py-6">
                <h3 class="text-base font-semibold tracking-[-0.01em] text-ink">
                  {concept.title}
                </h3>
                <p class="mt-2 max-w-[38rem] text-[0.9375rem] leading-relaxed text-slate">
                  {concept.body}
                </p>
              </li>
            ))
          }
        </ul>

        <div class="mt-12 border-t border-line pt-8">
          <h3 class="eyebrow">Capabilities</h3>
          <ul class="mt-5 flex flex-wrap gap-x-7 gap-y-3">
            {
              capabilities.map((capability) => (
                <li class="flex items-center gap-2.5 text-[0.9375rem] text-ink">
                  <span aria-hidden="true" class="h-px w-4 shrink-0 bg-line-strong" />
                  {capability}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
