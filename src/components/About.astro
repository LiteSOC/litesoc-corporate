---
import { capabilities, company } from '../data/site';
---

<section id="about" class="scroll-mt-24 border-b border-line py-[clamp(4rem,7vw,6.5rem)]">
  <div class="container-x">
    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(min(22.5rem,100%),1fr))] gap-[clamp(2.25rem,5vw,4.5rem)]"
    >
      <div>
        <p class="eyebrow">The Company</p>
        <h2 class="h-section mt-5 text-ink">Building Technology That Solves Real Problems</h2>

        <div class="mt-8 grid gap-3.5 border-t-2 border-ink pt-[1.625rem]">
          <div>
            <p class="eyebrow tracking-[0.18em]">Based in</p>
            <p class="mt-1.5 text-[0.96875rem] font-semibold text-ink">
              {company.hq}, {company.country}
            </p>
          </div>
          <div>
            <p class="eyebrow tracking-[0.18em]">Journey began</p>
            <p class="mt-1.5 text-[0.96875rem] font-semibold text-ink">
              {company.predecessor.year}, under {company.predecessor.name}
            </p>
          </div>
        </div>
      </div>

      <div>
        <div class="grid max-w-[40rem] gap-5 text-[1.0625rem] leading-[1.68] text-slate">
          <p>
            {company.legalName} is a Malaysian technology company focused on developing practical
            digital products and delivering modern technology solutions. Our work spans software
            engineering, cybersecurity, cloud, networking and infrastructure, alongside the
            development of our own platforms.
          </p>
          <p>
            We work on problems that are ordinary but consequential &mdash; keeping systems
            monitored, keeping records accurate, keeping networks segmented, keeping members
            informed. Whether we are delivering a client engagement or developing one of our own
            products, the standards are the same: secure defaults, clear interfaces, and systems
            designed around real operational workflows rather than assumptions about them.
          </p>
        </div>

        <div class="mt-10 border-t border-line pt-[1.625rem]">
          <p class="eyebrow">Core Capabilities</p>
          <ul
            class="mt-5 grid list-none grid-cols-[repeat(auto-fit,minmax(min(13.75rem,100%),1fr))] gap-x-7 gap-y-2.5 p-0"
          >
            {
              capabilities.map((capability) => (
                <li class="flex items-center gap-3 text-[0.9375rem] text-ink">
                  <span aria-hidden="true" class="h-px w-4 shrink-0 bg-line-strong" />
                  {capability}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
