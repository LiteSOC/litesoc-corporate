---
interface Props {
  size?: number;
  class?: string;
}

const { size = 14, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 14 14"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  aria-hidden="true"
  class:list={['shrink-0', className]}
>
  <path d="M2 7h9.5M7.5 3l4 4-4 4"></path>
</svg>
