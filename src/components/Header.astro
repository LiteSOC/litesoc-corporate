---
import Wordmark from './Wordmark.astro';
import { company, nav } from '../data/site';

/*
  Trailing slashes are normalised before comparison: Astro's directory build
  emits `/company/`, but a hand-typed `/company` must still light up the same
  nav item.
*/
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === (href.replace(/\/+$/, '') || '/');
---

<header
  class="sticky top-0 z-50 border-b border-line bg-paper/96 backdrop-blur-[4px]"
  data-site-header
>
  <div class="container-x">
    <div class="flex h-[4.875rem] items-center justify-between gap-5">
      <Wordmark size={44} href="/" />

      <nav aria-label="Primary" class="hidden items-center gap-1 menu:flex">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="px-3.5 py-2.5 text-[0.9375rem] font-medium text-slate transition-colors hover:text-ink aria-[current=page]:font-semibold aria-[current=page]:text-ink"
            >
              {item.label}
            </a>
          ))
        }
        <a href={`mailto:${company.email}`} class="btn btn-primary ml-3.5 min-h-11 px-[1.375rem]">
          Talk to Us
        </a>
      </nav>

      <button
        type="button"
        class="inline-flex h-[2.875rem] w-[2.875rem] items-center justify-center border border-line-strong text-ink transition-colors hover:border-ink menu:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
          data-menu-icon="open"
        >
          <path d="M2.5 5.5h15M2.5 10h15M2.5 14.5h15"></path>
        </svg>
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
          class="hidden"
          data-menu-icon="close"
        >
          <path d="M4.5 4.5l11 11M15.5 4.5l-11 11"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Primary"
    class="hidden border-t border-line bg-paper menu:hidden"
    data-mobile-nav
  >
    <div class="container-x flex flex-col pt-2 pb-5">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="border-b border-line py-[0.9375rem] text-[1.0625rem] font-semibold text-ink aria-[current=page]:text-sec"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={`mailto:${company.email}`}
        class="btn btn-primary mt-[1.125rem] min-h-12 justify-start"
      >
        Talk to Us
      </a>
    </div>
  </nav>
</header>

<script>
  /*
    The menu is a plain disclosure: no focus trap, because the panel is a
    sibling in source order, so tabbing out of it lands on the page content
    exactly where a sighted user would expect.
  */
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = header?.querySelector<HTMLElement>('[data-mobile-nav]');
  const openIcon = header?.querySelector<SVGElement>('[data-menu-icon="open"]');
  const closeIcon = header?.querySelector<SVGElement>('[data-menu-icon="close"]');

  if (toggle && panel && openIcon && closeIcon) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('hidden', !open);
      openIcon.classList.toggle('hidden', open);
      closeIcon.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    /* Crossing the breakpoint with the panel open would otherwise leave the
       toggle reporting expanded while the desktop nav is what's visible. */
    const wide = window.matchMedia('(min-width: 57.5rem)');
    wide.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
