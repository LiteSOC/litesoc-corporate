---
import Wordmark from './Wordmark.astro';
import { company, nav } from '../data/site';
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/95 backdrop-blur-[2px]">
  <div class="container-x">
    <div class="flex h-[4.5rem] items-center justify-between gap-4">
      <a
        href="/"
        class="-m-2 rounded-sm p-2"
        aria-label={`${company.legalName} — home`}
      >
        <Wordmark />
      </a>

      <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="rounded-sm px-3.5 py-2 text-[0.9375rem] font-medium text-slate transition-colors hover:text-ink"
            >
              {item.label}
            </a>
          ))
        }
        <a href="/#products" class="btn btn-primary ml-3">Our Products</a>
      </nav>

      <button
        type="button"
        id="menu-toggle"
        class="-mr-2 inline-flex h-11 w-11 items-center justify-center rounded-sm text-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Open main menu</span>
        <svg
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <path d="M2.5 5.5h15M2.5 10h15M2.5 14.5h15" data-icon="open"></path>
          <path d="M4.5 4.5l11 11M15.5 4.5l-11 11" data-icon="close" class="hidden"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Primary mobile"
    hidden
    class="border-t border-line bg-paper md:hidden"
  >
    <ul class="container-x flex flex-col py-3">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              data-menu-link
              class="block border-b border-line py-3.5 text-base font-medium text-ink"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="pt-4 pb-2">
        <a href="/#products" data-menu-link class="btn btn-primary w-full">Our Products</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const iconOpen = toggle.querySelector<SVGPathElement>('[data-icon="open"]');
    const iconClose = toggle.querySelector<SVGPathElement>('[data-icon="close"]');
    const label = toggle.querySelector('.sr-only');

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      if (label) label.textContent = open ? 'Close main menu' : 'Open main menu';
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.hidden);
    });

    menu.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Keep state honest if the viewport crosses the desktop breakpoint.
    const desktop = window.matchMedia('(min-width: 768px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
