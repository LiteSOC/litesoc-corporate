---
import { company } from '../data/site';

const facts = [
  { label: 'Company registration', value: company.registrationNo },
  { label: 'D-U-N-S', value: company.duns },
  { label: 'Incorporated', value: `${company.incorporated} · ${company.country}` },
] as const;
---

<section class="border-b border-line bg-mist">
  <div class="container-x">
    <dl class="credentials hairline m-0 grid-cols-[repeat(auto-fit,minmax(min(14.375rem,100%),1fr))]">
      {
        facts.map((fact) => (
          <div class="credential bg-mist py-[1.375rem] pr-6">
            <dt class="eyebrow text-[0.65625rem] tracking-[0.18em]">{fact.label}</dt>
            <dd class="mt-2 text-[0.9375rem] font-semibold tracking-[0.01em] text-ink">
              {fact.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /*
    The first cell sits flush with the container edge and the rest are inset,
    so the rules read as columns. Once the grid wraps to a single column that
    inset becomes a staircase, so it is scoped to the width at which two
    columns actually fit (2 × 14.375rem, the grid's own minmax floor).
  */
  .credentials {
    container-type: inline-size;
  }

  @container (min-width: 28.75rem) {
    .credential + .credential {
      padding-left: 1.5rem;
    }
  }
</style>
