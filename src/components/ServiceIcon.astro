---
import type { Service } from '../data/site';

interface Props {
  icon: Service['icon'];
  size?: number;
}

const { icon, size = 22 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class="shrink-0 text-ink"
>
  {
    icon === 'code' && (
      <>
        <path d="M8.5 9L5.5 12l3 3M15.5 9l3 3-3 3" />
        <path d="M3 6.5h18M3 6.5v11a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-11" />
      </>
    )
  }
  {
    icon === 'shield' && (
      <>
        <path d="M12 3l7 2.5v6c0 4-3 7.2-7 8.5-4-1.3-7-4.5-7-8.5v-6L12 3z" />
        <path d="M9.5 12l1.8 1.8 3.4-3.6" />
      </>
    )
  }
  {
    icon === 'network' && (
      <>
        <circle cx="12" cy="5" r="2.2" />
        <circle cx="5" cy="18.5" r="2.2" />
        <circle cx="19" cy="18.5" r="2.2" />
        <path d="M12 7.2v4.3M12 11.5H5.6a.6.6 0 0 0-.6.6v2.2M12 11.5h6.4a.6.6 0 0 1 .6.6v2.2" />
      </>
    )
  }
  {
    icon === 'cloud' && (
      <>
        <path d="M7.2 18.5A3.7 3.7 0 0 1 6.6 11a5.2 5.2 0 0 1 10.1-1.2 3.9 3.9 0 0 1-.6 8.7" />
        <path d="M12 12.5v6M12 12.5l-2.2 2.2M12 12.5l2.2 2.2" />
      </>
    )
  }
  {
    icon === 'server' && (
      <>
        <rect x="3.5" y="4" width="17" height="6" />
        <rect x="3.5" y="14" width="17" height="6" />
        <path d="M7 7h.01M7 17h.01" />
      </>
    )
  }
</svg>
