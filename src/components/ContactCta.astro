---
import { company, products } from '../data/site';

const facts = [
  { label: 'Registered office', address: true },
  { label: 'Co. Reg. No.', value: company.registrationNo },
  { label: 'D-U-N-S', value: company.duns },
] as const;
---

<section id="contact" class="scroll-mt-24 bg-ink py-[clamp(4rem,7vw,6.5rem)] text-paper">
  <div class="container-x">
    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(min(22.5rem,100%),1fr))] gap-[clamp(2.25rem,5vw,4.5rem)]"
    >
      <div>
        <p class="eyebrow text-paper/55">Contact</p>
        <h2
          class="mt-5 text-[clamp(1.875rem,1.3rem+2vw,3rem)] font-extrabold leading-[1.04] tracking-[-0.033em] text-paper"
        >
          Let&rsquo;s Build Something That Matters.
        </h2>
        <p class="mt-5 max-w-[32rem] text-[1.09375rem] leading-[1.6] text-paper/72">
          Whether you are developing a digital platform, improving cybersecurity or modernising
          infrastructure, talk to us about what you are trying to achieve.
        </p>
        <a href={`mailto:${company.email}`} class="btn btn-invert mt-[2.125rem] min-h-[3.25rem]">
          <svg
            width="17"
            height="17"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            aria-hidden="true"
          >
            <rect x="1.5" y="3" width="13" height="10"></rect>
            <path d="M1.5 4.5L8 9l6.5-4.5"></path>
          </svg>
          {company.email}
        </a>
      </div>

      <div class="grid content-start">
        {
          facts.map((fact, i) => (
            <div
              class:list={[
                'grid grid-cols-[repeat(auto-fit,minmax(min(9.375rem,100%),1fr))] gap-5 border-t border-paper/18 py-[1.125rem]',
                i === facts.length - 1 && 'border-b border-paper/18',
              ]}
            >
              <span class="text-[0.65625rem] font-bold uppercase tracking-[0.18em] text-paper/50">
                {fact.label}
              </span>
              {'address' in fact ? (
                <address class="text-[0.9375rem] not-italic leading-[1.6] text-paper/80">
                  {company.address.lines.map((line, n) => (
                    <>
                      {n > 0 && <br />}
                      {line}
                    </>
                  ))}
                </address>
              ) : (
                <span class="text-[0.9375rem] tracking-[0.01em] text-paper/80">{fact.value}</span>
              )}
            </div>
          ))
        }

        <div class="mt-[1.625rem] flex flex-wrap gap-2.5">
          {
            products.map((product) => (
              <a
                href={product.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-10 items-center border border-paper/25 px-3.5 text-[0.84375rem] font-medium text-paper/85 transition-colors hover:border-paper hover:text-paper"
              >
                {product.name} enquiries
              </a>
            ))
          }
          <a
            href={`mailto:${company.careersEmail}`}
            class="inline-flex min-h-10 items-center border border-paper/25 px-3.5 text-[0.84375rem] font-medium text-paper/85 transition-colors hover:border-paper hover:text-paper"
          >
            Careers
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
