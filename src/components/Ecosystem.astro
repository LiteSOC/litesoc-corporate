---
import StructureTree from './StructureTree.astro';
import { company } from '../data/site';
---

<section class="border-b border-line py-20 sm:py-24 lg:py-28">
  <div class="container-x">
    <div class="max-w-[46rem]">
      <p class="eyebrow">Company structure</p>
      <h2 id="ecosystem-heading" class="rule-heading mt-5 text-ink">
        How Litesoc is organised
      </h2>
      <p class="mt-5 text-[1.0625rem] leading-relaxed text-slate sm:text-lg">
        {company.legalName} works along two lines: platforms it owns and develops, and services it
        delivers for clients. LiteSOC and Digital Khairat are products of the company &mdash;
        branded independently, serving different sectors, built to the same engineering standards
        as our client work.
      </p>
    </div>

    <div class="mt-14 lg:mt-16">
      <div class="mx-auto max-w-4xl">
        <StructureTree variant="full" labelledby="ecosystem-heading" />
      </div>
    </div>
  </div>
</section>
