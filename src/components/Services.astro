---
import { services, company } from '../data/site';

/*
  Icons are inline SVG rather than an icon package: five 24px glyphs do not
  justify a dependency, and this keeps the shipped JavaScript at zero. They
  share the stroke weight and square caps used elsewhere on the site.
*/
const icons: Record<string, string> = {
  code: '<path d="M8.5 9L5.5 12l3 3M15.5 9l3 3-3 3"/><path d="M3 6.5h18M3 6.5v11a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-11"/>',
  shield:
    '<path d="M12 3l7 2.5v6c0 4-3 7.2-7 8.5-4-1.3-7-4.5-7-8.5v-6L12 3z"/><path d="M9.5 12l1.8 1.8 3.4-3.6"/>',
  network:
    '<circle cx="12" cy="5" r="2.2"/><circle cx="5" cy="18.5" r="2.2"/><circle cx="19" cy="18.5" r="2.2"/><path d="M12 7.2v4.3M12 11.5H5.6a.6.6 0 0 0-.6.6v2.2M12 11.5h6.4a.6.6 0 0 1 .6.6v2.2"/>',
  cloud:
    '<path d="M7.2 18.5A3.7 3.7 0 0 1 6.6 11a5.2 5.2 0 0 1 10.1-1.2 3.9 3.9 0 0 1-.6 8.7"/><path d="M12 12.5v6M12 12.5l-2.2 2.2M12 12.5l2.2 2.2"/>',
  server:
    '<rect x="3.5" y="4" width="17" height="6" rx="1"/><rect x="3.5" y="14" width="17" height="6" rx="1"/><path d="M7 7h.01M7 17h.01"/>',
};
---

<section id="services" class="scroll-mt-24 border-b border-line py-20 sm:py-24 lg:py-28">
  <div class="container-x">
    <div class="max-w-[46rem]">
      <p class="eyebrow">What we do</p>
      <h2 class="rule-heading mt-5 text-ink">Technology Services</h2>
      <p class="mt-5 text-[1.0625rem] leading-relaxed text-slate sm:text-lg">
        From software engineering to cybersecurity and infrastructure, we help organizations
        design, build and operate reliable technology solutions.
      </p>
    </div>

    <ul
      class="mt-14 grid gap-px overflow-hidden rounded-sm border border-line bg-line md:grid-cols-2 lg:mt-16 lg:grid-cols-3"
    >
      {
        services.map((service) => (
          <li class="group flex flex-col bg-paper p-7 transition-colors duration-200 hover:bg-mist">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 items-center justify-center rounded-sm border border-line text-ink transition-colors duration-200 group-hover:border-line-strong"
            >
              <svg
                class="h-[1.375rem] w-[1.375rem]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[service.icon]}
              />
            </span>

            <h3 class="mt-6 text-[1.0625rem] leading-snug font-semibold tracking-[-0.015em] text-ink">
              {service.name}
            </h3>

            <p class="mt-3 text-[0.9375rem] leading-relaxed text-slate">{service.description}</p>

            <ul class="mt-6 flex flex-wrap gap-1.5 pt-1">
              {service.capabilities.map((capability) => (
                <li class="rounded-sm border border-line px-2.5 py-1 font-mono text-[0.6875rem] tracking-[0.02em] text-slate">
                  {capability}
                </li>
              ))}
            </ul>
          </li>
        ))
      }

      {/* Fills the sixth cell of the 3-column grid with a real next step
          rather than an empty tile. */}
      <li class="flex flex-col justify-between bg-mist p-7">
        <div>
          <p class="eyebrow">Start a conversation</p>
          <p class="mt-5 text-[1.0625rem] leading-snug font-semibold tracking-[-0.015em] text-ink">
            Have a technology project, security requirement or infrastructure challenge?
          </p>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-slate">
            Tell us what you are working on and we will tell you how we would approach it.
          </p>
        </div>
        <a
          href={`mailto:${company.email}`}
          class="mt-7 inline-flex min-h-11 items-center gap-2 self-start text-[0.9375rem] font-medium text-ink"
        >
          Talk to us
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M2 7h9.5M7.5 3l4 4-4 4" />
          </svg>
        </a>
      </li>
    </ul>
  </div>
</section>
