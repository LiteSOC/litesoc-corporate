---
import Arrow from './Arrow.astro';
import ServiceIcon from './ServiceIcon.astro';
import { company, services } from '../data/site';
---

<section id="services" class="scroll-mt-24 border-b border-line py-[clamp(4rem,7vw,6.5rem)]">
  <div class="container-x">
    <div class="max-w-[44rem]">
      <p class="eyebrow">What We Do</p>
      <h2 class="h-section mt-5 text-ink">Technology Services</h2>
      <p class="mt-[1.125rem] text-[1.09375rem] leading-[1.62] text-slate">
        From software engineering to cybersecurity and infrastructure, we help organizations design,
        build and operate reliable technology environments.
      </p>
    </div>

    <div
      class="hairline mt-[clamp(2.5rem,4vw,3.75rem)] grid-cols-[repeat(auto-fit,minmax(min(18.75rem,100%),1fr))] border border-line"
    >
      {
        services.map((service, i) => (
          <article class="flex flex-col bg-paper px-7 py-[1.875rem] transition-colors hover:bg-mist">
            <div class="flex items-center justify-between">
              <span class="text-[0.6875rem] font-bold tracking-[0.16em] text-line-strong">
                {String(i + 1).padStart(2, '0')}
              </span>
              <ServiceIcon icon={service.icon} />
            </div>
            <h3 class="mt-6 text-[1.1875rem] font-bold leading-[1.25] tracking-[-0.02em] text-ink">
              {service.name}
            </h3>
            <p class="mt-3 text-[0.9375rem] leading-[1.62] text-slate">{service.description}</p>
            <ul class="mt-[1.375rem] flex list-none flex-wrap gap-1.5 p-0">
              {service.tags.map((tag) => (
                <li class="border border-line px-2.5 py-[5px] text-[0.71875rem] font-medium tracking-[0.02em] text-slate">
                  {tag}
                </li>
              ))}
            </ul>
          </article>
        ))
      }

      <article class="flex flex-col justify-between bg-mist px-7 py-[1.875rem]">
        <div>
          <p class="eyebrow">Start a Conversation</p>
          <p
            class="mt-5 text-[1.1875rem] font-bold leading-[1.28] tracking-[-0.02em] text-ink"
          >
            Have a technology project, security requirement or infrastructure challenge?
          </p>
          <p class="mt-3 text-[0.9375rem] leading-[1.62] text-slate">
            Tell us what you are working on and we will tell you how we would approach it.
          </p>
        </div>
        <a href={`mailto:${company.email}`} class="link-arrow mt-7">
          Talk to us
          <Arrow />
        </a>
      </article>
    </div>
  </div>
</section>
