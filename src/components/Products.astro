---
import Arrow from './Arrow.astro';
import { accentClasses, company, products } from '../data/site';
---

<section id="products" class="scroll-mt-24 border-b border-line py-[clamp(4rem,7vw,6.5rem)]">
  <div class="container-x">
    <div class="max-w-[44rem]">
      <p class="eyebrow">Owned and Developed by {company.shortName}</p>
      <h2 class="h-section mt-5 text-ink">Products We Build</h2>
      <p class="mt-[1.125rem] text-[1.09375rem] leading-[1.62] text-slate">
        Purpose-built platforms developed by {company.legalName} to solve distinct operational and
        community challenges.
      </p>
    </div>

    <div
      class="mt-[clamp(2.5rem,4vw,3.75rem)] grid grid-cols-[repeat(auto-fit,minmax(min(25rem,100%),1fr))] gap-[clamp(1.25rem,2.4vw,2rem)]"
    >
      {
        products.map((product) => {
          const accent = accentClasses[product.accent];
          return (
            <article
              class:list={[
                'flex flex-col border border-line border-t-[3px] bg-paper p-[clamp(1.625rem,2.6vw,2.375rem)] transition-colors',
                accent.topRule,
                accent.hoverBorder,
              ]}
            >
              <div class="flex items-center justify-between gap-5">
                <img
                  src={product.logo}
                  width={product.logoWidth}
                  height={product.logoHeight}
                  alt={product.name}
                  loading="lazy"
                  decoding="async"
                  class="block h-[4.5rem] w-auto object-contain"
                />
                <span
                  class:list={[
                    'text-right text-[0.6875rem] font-bold uppercase tracking-[0.18em]',
                    accent.text,
                  ]}
                >
                  {product.kicker}
                </span>
              </div>

              <h3 class="mt-[1.625rem] text-[clamp(1.625rem,2.2vw,2.125rem)] font-extrabold tracking-[-0.03em] text-ink">
                {product.name}
              </h3>
              <p class="mt-3.5 text-base leading-[1.65] text-slate">{product.description}</p>

              <ul class="mt-[1.625rem] grid list-none gap-2.5 p-0">
                {product.highlights.map((highlight) => (
                  <li class="flex items-start gap-3 text-[0.9375rem] text-ink">
                    <span class:list={['mt-[9px] h-0.5 w-3 shrink-0', accent.rule]} />
                    {highlight}
                  </li>
                ))}
              </ul>

              <div class="mt-auto flex flex-wrap items-center justify-between gap-4 border-t border-line pt-8">
                <span class="text-[0.8125rem] tracking-[0.03em] text-slate-400">
                  {product.domain}
                </span>
                <a
                  href={product.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={['link-arrow', accent.text]}
                >
                  {product.cta}
                  <Arrow />
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
