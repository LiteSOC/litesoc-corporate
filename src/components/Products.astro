---
import { products, accentClasses } from '../data/site';
---

<section id="products" class="scroll-mt-24 border-b border-line py-20 sm:py-24 lg:py-28">
  <div class="container-x">
    <div class="max-w-[46rem]">
      <p class="eyebrow">Our portfolio</p>
      <h2 class="rule-heading mt-5 text-ink">Our Products</h2>
      <p class="mt-5 text-[1.0625rem] leading-relaxed text-slate sm:text-lg">
        Purpose-built digital platforms designed for different real-world challenges.
      </p>
    </div>

    <ul class="mt-14 grid gap-6 lg:mt-16 lg:grid-cols-2 lg:gap-8">
      {
        products.map((product) => {
          const accent = accentClasses[product.accent];
          return (
            <li class="group relative flex">
              <article
                class={`relative flex w-full flex-col overflow-hidden rounded-sm border border-line bg-paper p-7 transition-colors duration-200 sm:p-9 ${accent.border}`}
              >
                <span aria-hidden="true" class={`absolute inset-x-0 top-0 h-[3px] ${accent.rule}`} />

                <p class={`eyebrow ${accent.text}`}>{product.category}</p>

                <h3 class="mt-5 text-[1.75rem] font-semibold tracking-[-0.025em] text-ink sm:text-3xl">
                  {product.name}
                </h3>

                <p class="mt-4 text-[0.9375rem] leading-relaxed text-slate sm:text-base">
                  {product.description}
                </p>

                <ul class="mt-7 space-y-2.5">
                  {product.highlights.map((highlight) => (
                    <li class="flex items-start gap-3 text-[0.9375rem] text-ink">
                      <span
                        aria-hidden="true"
                        class={`mt-[0.5625rem] h-1 w-3 shrink-0 ${accent.rule}`}
                      />
                      {highlight}
                    </li>
                  ))}
                </ul>

                <div class="mt-auto pt-9">
                  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
                    <span class="font-mono text-xs text-slate-400">{product.domain}</span>

                    <a
                      href={product.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={`inline-flex min-h-11 items-center gap-2 text-[0.9375rem] font-medium ${accent.text}`}
                    >
                      {product.cta}
                      <span class="sr-only">(opens in a new tab)</span>
                      <svg
                        class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
                        viewBox="0 0 14 14"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        aria-hidden="true"
                      >
                        <path d="M2 7h9.5M7.5 3l4 4-4 4" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
