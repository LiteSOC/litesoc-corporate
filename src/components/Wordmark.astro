---
import { company } from '../data/site';

interface Props {
  /** Mark size in px. The lockup type scales with it. */
  size?: number;
  /** Header uses a link; the footer repeats the mark decoratively. */
  href?: string | null;
  class?: string;
}

const { size = 44, href = '/', class: className = '' } = Astro.props;

const Tag = href ? 'a' : 'div';
const nameSize = size >= 44 ? 'text-[1.1875rem]' : 'text-[1.125rem]';
---

<Tag
  {...href ? { href, 'aria-label': `${company.legalName} — home` } : {}}
  class:list={['flex items-center gap-3', className]}
>
  <img
    src="/images/litesoc-company-logo.png"
    width={size}
    height={size}
    alt=""
    decoding="async"
    class="block shrink-0 object-contain"
    style={`width:${size}px;height:${size}px`}
  />
  <span class="flex flex-col leading-none">
    <span class:list={[nameSize, 'font-extrabold tracking-[-0.02em] text-ink']}>
      {company.shortName}
    </span>
    <span
      class="mt-[5px] text-[0.59375rem] font-semibold tracking-[0.24em] text-slate-400 uppercase"
    >
      {company.suffix}
    </span>
  </span>
</Tag>
