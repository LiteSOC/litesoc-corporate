---
import { principles } from '../data/site';
---

<section class="border-b border-line py-[clamp(4rem,7vw,6.5rem)]">
  <div class="container-x">
    <p class="eyebrow">How We Work</p>
    <h2 class="h-section mt-5 max-w-[30rem] text-ink">Engineering Principles</h2>

    <div
      class="hairline mt-[clamp(2.5rem,4vw,3.75rem)] grid-cols-[repeat(auto-fit,minmax(min(17.5rem,100%),1fr))] border-t-2 border-ink"
    >
      {
        principles.map((principle) => (
          <div class="bg-paper px-7 pt-8 pb-9">
            <span aria-hidden="true" class="block h-0.5 w-10 bg-ink" />
            <h3 class="mt-[1.375rem] text-[1.3125rem] font-bold tracking-[-0.02em] text-ink">
              {principle.title}
            </h3>
            <p class="mt-3 text-[0.96875rem] leading-[1.65] text-slate">{principle.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
